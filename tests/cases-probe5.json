[
  { "key": "g-crlf-end-nobs", "why": "6.22 matched lines run to the end -> result ends with a break (CRLF file)",
    "argv": ["--format=unified"], "stdin": "--- a/f\n+++ b/f\n@@ -2 +2 @@\n-b\n+c\n", "files": { "f": "a\r\nb" } },
  { "key": "g-crlf-mid", "why": "3.7 not at the end: the file's final break stays",
    "argv": ["--format=unified"], "stdin": "--- a/f\n+++ b/f\n@@ -1 +1 @@\n-a\n+A\n", "files": { "f": "a\r\nb\r\n" } },
  { "key": "g-crlf-nobs-flag", "why": "6.22 backslash after the last + line -> no final break",
    "argv": ["--format=unified"], "stdin": "--- a/f\n+++ b/f\n@@ -2 +2 @@\n-b\n+c\n\\ No newline at end of file\n", "files": { "f": "a\r\nb" } },
  { "key": "g-tier2-empty-F", "why": "5.8 F empty, P non-empty: P is replaced by nothing",
    "argv": ["--format=unified"], "stdin": "--- a/f\n+++ b/f\n@@ -1 +1 @@\n-  old\n+  new\n", "files": { "f": "old\n" } },
  { "key": "g-tier2-ws-only-N", "why": "5.8 a line of N that is only whitespace is written as it is",
    "argv": ["--format=unified"], "stdin": "--- a/f\n+++ b/f\n@@ -1 +1,2 @@\n-  old\n+  new\n+   \n", "files": { "f": "\told\n" } },
  { "key": "g-tier2-ctx-keeps", "why": "5.7 a context line is written as the file's own matched line",
    "argv": ["--format=unified"], "stdin": "--- a/f\n+++ b/f\n@@ -1,2 +1,2 @@\n  keep\n-  old\n+  new\n", "files": { "f": "\tkeep  \n\told\n" } },
  { "key": "g-bs-not-at-end", "why": "6.22 when the matched lines do not run to the end, the final break stays as it was",
    "argv": ["--format=unified"], "stdin": "--- a/f\n+++ b/f\n@@ -1 +1 @@\n-a\n+A\n\\ No newline at end of file\n", "files": { "f": "a\nb" } },
  { "key": "g-tier2-P-longer", "why": "5.8 P is O's first line's leading run, F the file's",
    "argv": ["--format=unified"], "stdin": "--- a/f\n+++ b/f\n@@ -1 +1 @@\n- foo\n+ bar\n", "files": { "f": "  foo\n" } },
  { "key": "g-sr-tier2", "why": "5.8 tier 2 re-indentation applies to SEARCH/REPLACE too",
    "argv": ["--format=search-replace"], "stdin": "f\n<<<<<<< SEARCH\nfoo\n=======\nbar\n>>>>>>> REPLACE\n", "files": { "f": "\tfoo\n" } },
  { "key": "g-v4a-tier2", "why": "5.8 tier 2 re-indentation applies to V4A chunks",
    "argv": ["--format=v4a"], "stdin": "*** Begin Patch\n*** Update File: f\n@@\n-foo\n+bar\n*** End Patch\n", "files": { "f": "\tfoo\n" } },
  { "key": "g-json-insert-crlf-newstr", "why": "9.6 new_str lines with \\r\\n, CRLF file",
    "argv": ["--format=json"], "stdin": "{\"command\":\"insert\",\"path\":\"f\",\"insert_line\":0,\"new_str\":\"x\\r\\ny\"}\n", "files": { "f": "a\r\nb\r\n" } },
  { "key": "g-json-create-bytes", "why": "9.4 create writes file_text byte for byte",
    "argv": ["--format=json"], "stdin": "{\"command\":\"create\",\"path\":\"f\",\"file_text\":\"a\\r\\nb\"}\n", "files": {} },
  { "key": "g-check-exit1", "why": "1.5 --check writes nothing even on failure",
    "argv": ["--check", "--format=json"], "stdin": "{\"command\":\"create\",\"path\":\"n\",\"file_text\":\"q\"}\n{\"command\":\"str_replace\",\"path\":\"a\",\"old_str\":\"zz\"}\n", "files": { "a": "x\n" } },
  { "key": "g-empty-o-at-top", "why": "6.21 A=0: insert at the top",
    "argv": ["--format=unified"], "stdin": "--- a/f\n+++ b/f\n@@ -0,0 +1 @@\n+top\n", "files": { "f": "a\nb\n" } },
  { "key": "g-empty-o-into-empty-file", "why": "6.21/6.22 insertion at the end of an empty file",
    "argv": ["--format=unified"], "stdin": "--- a/f\n+++ b/f\n@@ -0,0 +1 @@\n+x\n", "files": { "f": "" } },
  { "key": "g-delete-all-lines", "why": "3.6 a file of no lines is written empty",
    "argv": ["--format=unified"], "stdin": "--- a/f\n+++ b/f\n@@ -1,2 +0,0 @@\n-a\n-b\n", "files": { "f": "a\nb" } },
  { "key": "g-move-nochange", "why": "2.13 R when the moved file's bytes are unchanged",
    "argv": ["--format=unified"], "stdin": "diff --git a/a.txt b/b.txt\nsimilarity index 100%\nrename from a.txt\nrename to b.txt\n", "files": { "a.txt": "x\n" } },
  { "key": "g-move-back", "why": "2.14 moving a file and back changes no path",
    "argv": ["--format=json"], "stdin": "{\"command\":\"create\",\"path\":\"tmp\",\"file_text\":\"\"}\n", "files": {} }
]
