  {
   "key": "a-r/sort-key",
   "group": "a",
   "family": "a-r",
   "why": "2: R replaces the pair's D and A lines and sorts by <new>",
   "argv": [
    "--format=v4a"
   ],
   "stdin": "*** Begin Patch\n*** Update File: m.txt\n*** Move to: b.txt\n*** Add File: c.txt\n+z\n*** Delete File: d.txt\n*** End Patch\n",
   "files": {
    "m.txt": "hello\n",
    "d.txt": "gone\n"
   },
   "expect": {
    "exit": 0,
    "stdout": "R m.txt -> b.txt\nA c.txt\nD d.txt\nok: 3 files\n",
    "changes": {
     "m.txt": null,
     "b.txt": "hello\n",
     "c.txt": "z\n",
     "d.txt": null
    }
   }
  },
  {
   "key": "a-r/unchanged-bytes",
