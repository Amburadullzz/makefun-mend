{
 "checks": [
  {
   "key": "a-order/usage-beats-no-patch",
   "group": "a",
   "family": "a-order",
   "why": "2: a usage error wins over everything",
   "argv": [
    "--bogus",
    "nope.patch"
   ],
   "stdin": null,
   "files": {},
   "expect": {
    "exit": 2,
    "stdout": "error: usage\n",
    "changes": {}
   }
  },
  {
   "key": "a-order/no-patch-beats-format",
   "group": "a",
   "family": "a-order",
   "why": "2: no-patch is tried before format",
   "argv": [
    "nope.patch"
   ],
   "stdin": null,
   "files": {},
   "expect": {
    "exit": 2,
    "stdout": "error: no-patch\n",
    "changes": {}
   }
  },
  {
   "key": "a-order/parse-before-any-file",
   "group": "a",
   "family": "a-order",
   "why": "2: a parse error is reported before any file is looked at",
   "argv": [
    "--format=unified"
   ],
   "stdin": "--- a/nofile\n+++ b/nofile\n@@ -1,1 +1,1 @@\n-x\n+y\n@@ bogus\n",
   "files": {},
   "expect": {
    "exit": 2,
    "stdout": "error: parse 6\n",
    "changes": {}
   }
  },
  {
   "key": "a-order/usage-beats-parse",
   "group": "a",
   "family": "a-order",
   "why": "2: a usage error wins over a parse error",
   "argv": [
    "--format=bogus",
    "p.patch"
   ],
   "stdin": null,
   "files": {
    "p.patch": "@@ bogus\n"
   },
   "expect": {
    "exit": 2,
    "stdout": "error: usage\n",
    "changes": {}
   }
  },
  {
   "key": "a-order/two-positionals",
   "group": "a",
   "family": "a-order",
   "why": "1: more than one positional argument is a usage error",
   "argv": [
    "a.patch",
    "b.patch"
   ],
   "stdin": null,
   "files": {
    "a.patch": "x"
   },
   "expect": {
    "exit": 2,
    "stdout": "error: usage\n",
    "changes": {}
   }
  },
  {
   "key": "a-order/format-twice",
   "group": "a",
   "family": "a-order",
   "why": "1: an option given twice is a usage error",
   "argv": [
    "--format=json",
    "--format=unified"
   ],
   "stdin": "",
   "files": {},
   "expect": {
    "exit": 2,
    "stdout": "error: usage\n",
    "changes": {}
   }
  },
  {
   "key": "a-order/dashdash",
   "group": "a",
   "family": "a-order",
   "why": "1: -- ends the options, so - is the PATCH and reads stdin",
   "argv": [
    "--format=json",
    "--",
    "-"
   ],
   "stdin": "{\"command\":\"create\",\"path\":\"a\",\"file_text\":\"x\"}\n",
   "files": {},
   "expect": {
    "exit": 0,
    "stdout": "A a\nok: 1 file\n",
    "changes": {
     "a": "x"
    }
   }
  },
